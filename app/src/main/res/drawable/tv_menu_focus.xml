<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tv_surface_highlight" />
            <stroke android:width="2dp" android:color="@color/tv_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/tv_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="12dp" /></shape></item>
</selector>
